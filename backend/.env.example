# ==============================================================================
# WAYORA Travels Backend Environment Configuration (Template)
# ==============================================================================
# Copy this file to `.env` on your PHP server and fill in real values.
# NEVER commit the real `.env` file containing credentials to source control.

# Application Environment (development | production)
APP_ENV=development

# Allowed CORS Origins (comma-separated, no trailing slashes)
# In production, include your GitHub Pages origin (e.g. https://kadhiravan2002.github.io)
ALLOWED_ORIGINS=http://localhost:4200,https://kadhiravan2002.github.io

# ------------------------------------------------------------------------------
# Gmail SMTP Configuration
# ------------------------------------------------------------------------------
# Host: smtp.gmail.com
# Port: 587 (TLS/STARTTLS) or 465 (SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls

# Your Google Account Email
SMTP_USER=kadhiravan2026@gmail.com

# 16-character Google App Password (NOT your personal Google account password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASS=your_16_char_google_app_password

# From Name displayed in notifications
SMTP_FROM_NAME="WAYORA Travels Notifications"

# Recipient Email address that receives contact & newsletter alerts
NOTIFICATION_RECIPIENT=kadhiravan2026@gmail.com
